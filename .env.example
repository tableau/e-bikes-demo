VITE_USERNAME=
VITE_CLIENT_ID=
VITE_SECRET_ID=
VITE_SECRET_VALUE=
VITE_SERVER=
VITE_SITE=
VITE_SUBSCRIBER=
VITE_DATASOURCE_LUID=

# Optional: base URL of this app (for API calls). Leave empty for same-origin.
# VITE_APP_SERVER=

# ============================================
# Salesforce (Tableau Next) – server only
# Used for Mario's Analytics tab. Works locally and on Heroku via config vars.
# ============================================
# ECA (External Client App) consumer key
SALESFORCE_CLIENT_ID=
# Login URL: https://login.salesforce.com or https://test.salesforce.com
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Salesforce username (subject for JWT)
SALESFORCE_USER=
# Option A: Full PEM string. Use \n for newlines (e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----").
# The app turns \n into real newlines. Works in .env and Heroku config vars.
SALESFORCE_PRIVATE_KEY=
# Option B: Or set a key file path instead (e.g. ./server.key).
# SALESFORCE_PRIVATE_KEY_PATH=./server.key

# Optional: cache /salesforce-auth result to skip repeated OAuth + singleaccess (default 300s). Set 0 to disable session cache (token cache still applies).
# SALESFORCE_AUTH_SESSION_CACHE_SECONDS=300
# Optional: log server timings for auth (token vs singleaccess). Set to 1 or true.
# SALESFORCE_AUTH_DEBUG=1

# Optional: Analytics agent component ID (Salesforce ID) for the chat button. Set in build env as VITE_* for client.
# VITE_SALESFORCE_ANALYTICS_AGENT_ID=