# ============================================
# E-Bikes Demo Application - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env
# DO NOT commit .env file with real credentials to version control

# ============================================
# Server Configuration
# ============================================
# Port for the Express server (default: 4001)
PORT=4001

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# Tableau Configuration (Required)
# ============================================
# Your Tableau Cloud server URL (without https://)
VITE_SERVER=your-tableau-server.tableau.com

# Your Tableau site content URL
VITE_SITE=your-site-name

# Your Tableau subscriber name
VITE_SUBSCRIBER=your-subscriber-name

# Data source LUID for VDS queries
VITE_DATASOURCE_LUID=your-datasource-luid

# Application server URL (for API calls from client)
# In development, this is typically http://localhost:4001
# In production, use your deployed URL
VITE_APP_SERVER=http://localhost:4001

# ============================================
# Tableau Connected App (Required for JWT)
# ============================================
# Consumer Key (Client ID) from Tableau Connected App
VITE_CLIENT_ID=your-tableau-client-id

# Secret ID from Tableau Connected App
VITE_SECRET_ID=your-tableau-secret-id

# Secret Value from Tableau Connected App
VITE_SECRET_VALUE=your-tableau-secret-value

# Username for Tableau impersonation
VITE_USERNAME=your-tableau-username@example.com

# ============================================
# OpenAI Configuration (Required for AI Assistant)
# ============================================
# Your OpenAI API key for MCP chat functionality
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# Tableau MCP Configuration (Required for AI Assistant)
# ============================================
# Personal Access Token name (default: MCP)
TABLEAU_PAT_NAME=MCP

# Personal Access Token value
TABLEAU_PAT_VALUE=your-tableau-pat-token

# ============================================
# Salesforce Configuration (Optional - for Analytics Agent)
# ============================================
# Only required if you want to use the Salesforce Analytics Agent component
# See docs/SALESFORCE_ANALYTICS_SETUP.md for setup instructions

# Salesforce org URL (Lightning domain)
# Example: https://yourorg.lightning.force.com or https://yourorg.my.salesforce.com
VITE_SALESFORCE_ORG_URL=https://yourorg.lightning.force.com

# Consumer Key from Salesforce External Client App
VITE_SALESFORCE_CONSUMER_KEY=your_salesforce_consumer_key

# Lightning Out App ID (required for Analytics Agent embedding)
VITE_SALESFORCE_LIGHTNING_OUT_APP_ID=your_lightning_out_app_id

# Option 1 (Recommended): Path to your private key file (e.g., ./privatekey.pem)
# The private key file should be in PEM format
VITE_SALESFORCE_PRIVATE_KEY_PATH=./privatekey.pem

# Option 2 (Alternative): Direct private key content (only if VITE_SALESFORCE_PRIVATE_KEY_PATH is not set)
# Use \n for newlines in the key
# VITE_SALESFORCE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT\n-----END PRIVATE KEY-----"

# Salesforce username for authentication (user to impersonate)
VITE_SALESFORCE_USERNAME=user@example.com
